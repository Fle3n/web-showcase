      "css": ".ds-flow-primary{font-family:Golos,Arial,sans-serif;display:inline-flex;align-items:center;justify-content:center;gap:12px;min-height:48px;padding:13px 22px;border:1px solid transparent;border-radius:8px;font-size:14px;font-weight:600;line-height:1.4;cursor:pointer;transition:background .2s,transform .2s,border-color .2s;background:var(--accent,#244bce);color:var(--surface,#fff)}.ds-flow-primary:hover{background:var(--hover,#1d3eae)}.ds-flow-primary:focus-visible{outline:3px solid var(--focus,#244bce);outline-offset:4px}.ds-flow-primary:active{transform:translateY(1px)}@media(prefers-reduced-motion:reduce){.ds-flow-primary{transition:none}}"
    },
