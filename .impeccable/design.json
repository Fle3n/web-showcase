  "components": [
    {
      "name": "Coffee Primary Button",
      "kind": "button",
      "refersTo": "coffee-button-primary",
      "description": "Scoped primary action; fallback colors preserve this surface in isolation.",
      "html": "<button class=\"ds-coffee-primary\">Добавить за 240 ₽</button>",
      "css": ".ds-coffee-primary{font-family:Golos,Arial,sans-serif;display:inline-flex;align-items:center;justify-content:center;gap:12px;min-height:48px;padding:13px 22px;border:1px solid transparent;border-radius:8px;font-size:14px;font-weight:600;line-height:1.4;cursor:pointer;transition:background .2s,transform .2s,border-color .2s;background:var(--accent,#25342a);color:var(--surface,#fff)}.ds-coffee-primary:hover{background:var(--hover,#415443)}.ds-coffee-primary:focus-visible{outline:3px solid var(--focus,#6c823a);outline-offset:4px}.ds-coffee-primary:active{transform:translateY(1px)}@media(prefers-reduced-motion:reduce){.ds-coffee-primary{transition:none}}"
    },
    {
      "name": "Clinic Primary Button",
