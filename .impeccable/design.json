      "css": ".ds-secondary{font-family:Golos,Arial,sans-serif;display:inline-flex;align-items:center;justify-content:center;gap:12px;min-height:48px;padding:13px 22px;border:1px solid transparent;border-radius:8px;font-size:14px;font-weight:600;line-height:1.4;cursor:pointer;transition:background .2s,transform .2s,border-color .2s;background:transparent;border-color:var(--line,#d9ddd5);color:var(--ink,#242922)}.ds-secondary:hover{background:var(--tint,#f0f2ec)}.ds-secondary:focus-visible{outline:3px solid var(--focus,#244bce);outline-offset:4px;}.ds-secondary:active{transform:translateY(1px)}@media(prefers-reduced-motion:reduce){.ds-secondary{transition:none}}"
    },
    {
      "name": "Shared Text Field",
      "kind": "input",
      "refersTo": "shared-field",
      "description": "Labeled field; border and focus inherit the surface.",
      "html": "<label class=\"ds-field\">Имя или проект<input placeholder=\"Например, мастерская керамики\"></label>",
      "css": ".ds-field{font-family:Golos,Arial,sans-serif;display:grid;gap:8px;font-size:14px;font-weight:600;color:var(--ink,#20283d)}.ds-field input{font-family:Golos,Arial,sans-serif;min-width:0;padding:13px 14px;border:1px solid var(--line,#dce1eb);border-radius:8px;background:var(--surface,#fff);color:inherit;font-size:15px;font-weight:400;line-height:1.5}.ds-field input::placeholder{color:var(--muted,#5c6579)}.ds-field input:focus{border-color:var(--focus,#244bce)}.ds-field input:focus-visible{outline:3px solid var(--focus,#244bce);outline-offset:4px;}"
    },
    {
      "name": "Workspace Navigation",
      "kind": "nav",
      "refersTo": "flow-navigation",
      "description": "Cobalt navigation with written current-page state.",
      "html": "<nav class=\"ds-rail\" aria-label=\"Рабочие разделы\"><a href=\"#requests\" aria-current=\"page\">Заявки</a><a href=\"#brief\">Бриф</a></nav>",
      "css": ".ds-rail{font-family:Golos,Arial,sans-serif;display:grid;gap:7px;padding:20px;background:var(--accent,#244bce);color:#fff}.ds-rail a{display:flex;padding:13px 12px;border-radius:8px;font-size:14px;color:inherit;text-decoration:none;transition:background .18s}.ds-rail a:hover{background:#365bd3}.ds-rail a[aria-current=page]{background:#fff;color:var(--accent,#244bce)}.ds-rail a:focus-visible{outline:3px solid var(--focus,#244bce);outline-offset:4px}@media(prefers-reduced-motion:reduce){.ds-rail a{transition:none}}"
    },
    {
      "name": "Workspace State",
      "kind": "chip",
      "refersTo": "flow-state-new",
      "description": "Noninteractive state label: word and dot accompany color.",
      "html": "<span class=\"ds-state\">Новая</span>",
      "css": ".ds-state{font-family:Golos,Arial,sans-serif;display:inline-flex;align-items:center;gap:6px;width:max-content;border-radius:5px;padding:4px 7px;font-size:12px;font-weight:600;line-height:1.4;background:#fff1db;color:#8a4d10}.ds-state::before{content:\"\";width:5px;height:5px;border-radius:50%;background:currentColor}"
    },
    {
      "name": "Workspace Request Row",
      "kind": "card",
      "refersTo": "flow-request-row",
      "description": "Selectable journal entry; actual event handling lives in flow/app.js.",
      "html": "<button class=\"ds-row\" aria-pressed=\"true\"><span><strong>Мастерская керамики</strong><span class=\"ds-excerpt\">Нужен сайт с каталогом.</span></span><span class=\"ds-channel\">Сайт</span><span class=\"ds-row-state\">В работе</span></button>",
      "css": ".ds-row{font-family:Golos,Arial,sans-serif;display:grid;grid-template-columns:minmax(0,1fr) 82px 85px;gap:12px;width:100%;padding:19px 20px;background:var(--surface,#fff);border:0;border-bottom:1px solid var(--line,#dce1eb);text-align:left;color:var(--ink,#20283d);cursor:pointer;transition:background .18s}.ds-row:hover{background:#f7f9ff}.ds-row[aria-pressed=true]{background:#edf2ff}.ds-row:focus-visible{outline:3px solid var(--focus,#244bce);outline-offset:4px;}.ds-row strong{display:block;font-size:13px;font-weight:600;line-height:1.5}.ds-excerpt{display:block;font-size:12px;color:var(--muted,#5c6579);line-height:1.65;margin-top:4px;overflow-wrap:anywhere}.ds-channel{font-size:12px;color:var(--muted,#5c6579);padding-top:2px}.ds-row-state{font-size:12px;border-radius:5px;padding:4px 7px;background:#e8edff;color:#244bce;align-self:start}@media(prefers-reduced-motion:reduce){.ds-row{transition:none}}"
    },
    {
      "name": "Coffee Radio Segment",
      "kind": "custom",
      "refersTo": "coffee-segment",
      "description": "Keyboard reachable milk option with visible checked and focus states.",
      "html": "<label class=\"ds-segment\"><input type=\"radio\" name=\"ds-milk\" checked><span>Обычное</span></label>",
      "css": ".ds-segment{font-family:Golos,Arial,sans-serif;display:block;position:relative;cursor:pointer;max-width:220px}.ds-segment input{position:absolute;opacity:0;width:1px;height:1px}.ds-segment span{display:flex;justify-content:center;padding:13px 12px;border:1px solid var(--line,#d9ddd5);border-radius:8px;font-size:14px;transition:background .2s}.ds-segment input:checked+span{background:var(--accent,#25342a);border-color:var(--accent,#25342a);color:#fff}.ds-segment input:focus-visible+span{outline:3px solid var(--focus,#6c823a);outline-offset:3px}@media(prefers-reduced-motion:reduce){.ds-segment span{transition:none}}"
    },
    {
      "name": "Clinic Time Choice",
      "kind": "custom",
      "refersTo": "clinic-time",
      "description": "Compact appointment radio with disabled and checked treatments.",
      "html": "<label class=\"ds-time\"><input type=\"radio\" name=\"ds-time\" checked><span>10:00</span></label>",
      "css": ".ds-time{font-family:Golos,Arial,sans-serif;display:block;position:relative;cursor:pointer;max-width:100px}.ds-time input{position:absolute;width:1px;height:1px;opacity:0}.ds-time span{display:grid;place-items:center;border:1px solid #d7dfd1;padding:10px 4px;border-radius:7px;font-size:12px;min-height:40px;transition:background .2s,border-color .2s}.ds-time input:checked+span{background:var(--accent,#244a38);border-color:var(--accent,#244a38);color:#fff}.ds-time input:disabled+span{opacity:.35;cursor:not-allowed}.ds-time input:focus-visible+span{outline:3px solid var(--focus,#859f5c);outline-offset:3px}@media(prefers-reduced-motion:reduce){.ds-time span{transition:none}}"
    }
  ],
  "narrative": {
    "northStar": "Three Working Worlds",
    "overview": "Three working worlds share a quiet control language, while their palettes, type hierarchy and spatial density remain explicitly scoped. Тихо is a photographic product index on chalk white with pale yellow assistance. Линия is a forest and limestone appointment desk with Prata headings. Поток is a cobalt operations journal with compact Golos text and status-driven color.\n\nThis record describes the finished HTML/CSS, not a universal theme to apply across all three sites. The interfaces expose local demonstrations with visible limitations. Photography provenance remains in assets/v3-image-provenance.json; this document does not replace that record.",
    "keyCharacteristics": [
      "Three scoped palettes; one shared form and focus vocabulary.",
      "Photography carries the coffee and clinic atmosphere; tables and state carry the workspace.",
      "Flat panels, restrained borders and functional motion.",
      "Local demonstration disclosures remain close to their actions."
    ],
    "rules": [
      {
        "name": "The Scoped World Rule",
        "body": "Use coffee, clinic or flow tokens only inside their corresponding surface. Shared controls inherit that surface’s CSS custom properties.",
        "section": "colors"
      },
      {
        "name": "The Status Meaning Rule",
        "body": "In Поток, amber means new, cobalt means in progress and green means complete; always retain the written status.",
        "section": "colors"
      },
      {
        "name": "The Display Scope Rule",
        "body": "Prata belongs to Линия’s identity and principal headings. Coffee and workspace headings use Golos.",
        "section": "typography"
      },
      {
        "name": "The Flat Surface Rule",
        "body": "Resting content panels rely on background and borders. Reserve the observed shadows for the dialog and toast.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do preserve the three surface scopes and shared control inheritance.",
      "Do retain visible keyboard focus, semantic labels, status text and reduced-motion handling.",
      "Do use actual photographic assets for the coffee and clinic surfaces and retain their provenance record.",
      "Do keep demonstration limitations beside ordering, visit planning and request actions."
    ],
    "donts": [
      "Don't migrate clinic display typography or workspace status colors into the other identities.",
      "Don't replace the coffee photography with CSS food illustrations or add a ticker.",
      "Don't remove text from status chips or make color the only selected-state cue.",
      "Don't describe local assistant, cart or visit actions as live external services."
    ]
  }
}
